QMainWindow { background-color: ${bg}; color: ${text-primary}; }
QWidget { background-color: transparent; color: ${text-primary}; font-size: 13px; }
QLabel { color: ${text-primary}; font-size: 13px; }
QLabel[class="hint"] { color: ${text-muted}; font-size: 12px; }
QLabel[class="value"] { color: ${text-secondary}; font-size: 12px; }
QLabel[class="section"] { color: ${text-muted}; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
QLabel[class="section-heading"] { color: ${text-primary}; font-size: 14px; font-weight: 600; }
QLabel[class="input-label"] { color: ${text-secondary}; font-size: 13px; font-weight: 500; }
QLabel[class="success"] { color: ${success}; font-size: 13px; }
QLabel[class="warning"] { color: ${warning}; font-size: 13px; }
QLabel[class="error"] { color: ${danger}; font-size: 13px; }
QLabel[class="info"] { color: ${accent-light}; font-size: 13px; }
QLabel[class="preview-placeholder"] { color: ${text-muted}; font-size: 14px; font-style: italic; }
QLabel[thumbnail="true"] { border-radius: 10px; padding: 2px; background: ${card}; }
QWidget[card="true"] { background-color: ${card}; border: 1px solid ${border}; border-radius: 14px; padding: 16px; }
QWidget[card-sub="true"] { background-color: ${card}; border: 1px solid ${border}; border-radius: 14px; }
QWidget[card-well="true"] { background-color: ${card}; border: 1px solid ${border}; border-radius: 10px; padding: 12px; }
QWidget[nav="true"] { background-color: ${card}; border-bottom: 1px solid ${border}; border-top: none; border-left: none; border-right: none; border-radius: 0; padding: 0; }
QPushButton { background-color: ${card}; color: ${text-primary}; border: 1px solid ${border}; border-radius: 10px; padding: 8px 16px; font-size: 13px; font-weight: 500; min-height: 36px; }
QPushButton:hover { background-color: ${surface-hover}; border-color: ${accent}; }
QPushButton:pressed { background-color: ${accent}; color: ${text-primary}; }
QPushButton:disabled { color: ${text-muted}; border-color: ${border}; }
QPushButton:focus { border-color: ${input-focus}; }
QPushButton[flat="true"] { background: transparent; border: none; padding: 8px 12px; }
QPushButton[flat="true"]:hover { color: ${accent}; background: transparent; border: none; }
QPushButton[flat="true"]:focus { border: 1px solid ${input-focus}; padding: 7px 11px; }
QPushButton[gradient="true"] { background-color: ${accent}; color: ${text-primary}; border: none; font-weight: 700; border-radius: 14px; padding: 12px 24px; font-size: 16px; min-height: 44px; }
QPushButton[gradient="true"]:hover { background-color: ${accent-hover}; }
QPushButton[gradient="true"]:pressed { background-color: ${btn-pressed}; }
QPushButton[gradient="true"]:disabled { background-color: ${border}; color: #5A524B; }
QPushButton[class="stop"] { background-color: ${danger}; color: white; border: none; font-weight: 700; border-radius: 14px; padding: 12px 24px; font-size: 16px; min-height: 44px; }
QPushButton[class="stop"]:hover { background-color: #DC2626; }
QPushButton[class="stop"]:pressed { background-color: #B91C1C; }
QLineEdit { background-color: ${input-bg}; color: ${text-primary}; border: 1px solid ${input-border}; border-radius: 10px; padding: 8px 12px; font-size: 13px; min-height: 32px; selection-background-color: ${accent}; }
QLineEdit:focus { border: 2px solid ${input-focus}; padding: 7px 11px; }
QLineEdit:disabled { color: ${text-muted}; }
QTextEdit { background-color: ${input-bg}; color: ${text-primary}; border: 1px solid ${input-border}; border-radius: 10px; padding: 8px 12px; font-size: 13px; selection-background-color: ${accent}; }
QTextEdit:focus { border: 2px solid ${input-focus}; padding: 7px 11px; }
QComboBox { background-color: ${input-bg}; color: ${text-primary}; border: 1px solid ${input-border}; border-radius: 10px; padding: 8px 12px; font-size: 13px; min-height: 32px; }
QComboBox:hover { border-color: ${accent}; }
QComboBox:focus { border: 2px solid ${input-focus}; padding: 7px 11px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; top: 0; bottom: 0; right: 0; width: 24px; border: none; }
QComboBox QAbstractItemView { background-color: ${card}; color: ${text-primary}; border: 1px solid ${border}; border-radius: 10px; selection-background-color: ${surface-hover}; selection-color: ${accent}; outline: none; padding: 4px; }
QSpinBox, QDoubleSpinBox { background-color: ${input-bg}; color: ${text-primary}; border: 1px solid ${input-border}; border-radius: 10px; padding: 8px 12px; font-size: 13px; min-height: 32px; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid ${input-focus}; padding: 7px 11px; }
QSlider::groove:horizontal { background: ${slider-track}; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: ${slider-handle}; border: none; width: 16px; height: 16px; border-radius: 8px; margin: -6px 0; }
QSlider::handle:horizontal:hover { background: ${accent-hover}; }
QSlider::sub-page:horizontal { background: ${accent}; border-radius: 2px; }
QCheckBox { color: ${text-primary}; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 2px solid ${border}; background: ${input-bg}; }
QCheckBox::indicator:hover { border-color: ${accent}; }
QCheckBox::indicator:checked { background-color: ${accent}; border-color: ${accent}; }
QCheckBox:focus { outline: none; }
QCheckBox:focus::indicator { border-color: ${input-focus}; }
QProgressBar { background-color: ${border}; border: none; border-radius: 3px; text-align: center; height: 6px; font-size: 0; }
QProgressBar::chunk { background-color: ${accent}; border-radius: 3px; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: ${surface}; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: ${scrollbar-hover}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 0; }
QScrollBar::handle:horizontal { background: ${surface}; border-radius: 4px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: ${scrollbar-hover}; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QGroupBox { border: 1px solid ${border}; border-radius: 14px; margin-top: 14px; padding-top: 18px; font-weight: 600; font-size: 13px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 12px; left: 12px; color: ${text-secondary}; }
QTabBar[nav="true"] { border: none; background: transparent; padding: 0; min-height: 38px; }
QTabBar[nav="true"]::tab { background: transparent; color: ${text-secondary}; padding: 8px 24px; border: none; font-size: 13px; font-weight: 500; min-width: 60px; border-bottom: 2px solid transparent; margin: 0; }
QTabBar[nav="true"]::tab:selected { color: ${accent}; border-bottom: 2px solid ${accent}; }
QTabBar[nav="true"]::tab:hover { color: ${accent}; }
QTabBar:!nav { qproperty-drawBase: 0; }
QTabBar:!nav::tab { background: transparent; color: ${text-secondary}; padding: 8px 16px; border: 1px solid ${border}; font-size: 13px; font-weight: 500; margin-right: -1px; }
QTabBar:!nav::tab:first { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QTabBar:!nav::tab:last { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QTabBar:!nav::tab:selected { background-color: ${accent}; color: ${text-primary}; border-color: ${accent}; }
QTabBar:!nav::tab:hover:!selected { background-color: ${surface-hover}; border-color: ${accent}; }
QSplitter::handle { background: ${border}; width: 1px; }
