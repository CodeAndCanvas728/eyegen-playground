/* EyeGen — light theme.
 *
 * Grouping comes from space and type, not from boxes: the ground is one
 * surface, and the only fills are the things that take input. Cards are a
 * whisper of elevation, never a border.
 */

QMainWindow, QWidget#pageHost { background-color: ${bg}; color: ${text-primary}; }
QWidget { background-color: transparent; color: ${text-primary}; font-size: 13px; }

/* ── Type ──────────────────────────────────────────────────────────────── */
QLabel { color: ${text-primary}; font-size: 13px; }
QLabel[class="section-heading"] { color: ${text-primary}; font-size: 14px; font-weight: 600; }
QLabel[class="input-label"] { color: ${text-secondary}; font-size: 12px; font-weight: 500; }
QLabel[class="section"] { color: ${text-muted}; font-size: 11px; font-weight: 600; letter-spacing: 1.2px; }
QLabel[class="hint"] { color: ${text-muted}; font-size: 12px; }
QLabel[class="value"] { color: ${text-secondary}; font-size: 12px; }
QLabel[class="success"] { color: ${success}; font-size: 13px; }
QLabel[class="warning"] { color: ${warning}; font-size: 13px; }
QLabel[class="error"] { color: ${danger}; font-size: 13px; }
QLabel[class="info"] { color: ${accent-light}; font-size: 13px; }
QLabel[class="preview-placeholder"] { color: ${text-muted}; font-size: 15px; }

/* ── Grouping: a whisper of elevation, no borders ──────────────────────── */
QWidget[card="true"] { background-color: rgba(0, 0, 0, 0.02); border: none; border-radius: 14px; }
QWidget[card-sub="true"] { background-color: rgba(0, 0, 0, 0.02); border: none; border-radius: 14px; }
QWidget[card-well="true"] { background-color: ${surface}; border: none; border-radius: 10px; }

/* ── Preview: the one surface that is allowed to be a canvas ───────────── */
QWidget[preview="true"] { background-color: ${preview-bg}; border-radius: 16px; }

/* ── Buttons ───────────────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent; color: ${text-primary};
    border: 1px solid ${input-border}; border-radius: 9px;
    padding: 8px 14px; min-height: 20px; font-size: 13px; font-weight: 500;
}
QPushButton:hover { border-color: ${accent}; }
QPushButton:pressed { background-color: ${surface-hover}; border-color: ${accent}; }
QPushButton:disabled { color: ${text-muted}; border-color: ${border}; }
QPushButton:focus { border-color: ${input-focus}; }

QPushButton[flat="true"] { border: none; padding: 6px 2px; color: ${text-secondary}; }
QPushButton[flat="true"]:hover { color: ${accent}; }

QPushButton[gradient="true"] {
    background-color: ${accent}; color: #FFFFFF; border: none;
    font-size: 14px; font-weight: 600; border-radius: 11px; padding: 13px 20px; min-height: 22px;
}
QPushButton[gradient="true"]:hover { background-color: ${accent-hover}; }
QPushButton[gradient="true"]:pressed { background-color: ${btn-pressed}; }
QPushButton[gradient="true"]:disabled { background-color: ${surface}; color: ${text-muted}; }

QPushButton[class="stop"] {
    background-color: ${danger}; color: #FFFFFF; border: none;
    font-size: 14px; font-weight: 600; border-radius: 11px; padding: 13px 20px; min-height: 22px;
}
QPushButton[class="stop"]:hover { background-color: #DC2626; }
QPushButton[class="stop"]:pressed { background-color: #B91C1C; }

/* ── Inputs: the only fills on the ground ──────────────────────────────── */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: ${input-bg}; color: ${text-primary};
    border: 1px solid ${input-border}; border-radius: 9px;
    padding: 8px 10px; min-height: 22px; font-size: 13px;
    selection-background-color: ${accent};
}
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled { color: ${text-muted}; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid ${input-focus}; }
QLineEdit[error="true"] { border-color: ${danger}; }

QComboBox:hover { border-color: ${accent}; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 22px; border: none; }
QComboBox QAbstractItemView {
    background-color: ${surface}; color: ${text-primary};
    border: 1px solid ${border-light}; border-radius: 10px;
    selection-background-color: ${surface-hover}; selection-color: ${text-primary};
    outline: none; padding: 6px;
}

/* ── Sliders ───────────────────────────────────────────────────────────── */
QSlider::groove:horizontal { background: ${slider-track}; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: ${slider-handle}; border: none; width: 14px; height: 14px; border-radius: 7px; margin: -5px 0; }
QSlider::handle:horizontal:hover { background: ${accent-hover}; }
QSlider::sub-page:horizontal { background: ${accent}; border-radius: 2px; }

/* ── Checkboxes ────────────────────────────────────────────────────────── */
QCheckBox { color: ${text-primary}; font-size: 13px; spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 1px solid ${border-light}; background: ${input-bg}; }
QCheckBox::indicator:hover { border-color: ${accent}; }
QCheckBox::indicator:checked { background-color: ${accent}; border-color: ${accent}; }
QCheckBox:focus { outline: none; }
QCheckBox:focus::indicator { border-color: ${input-focus}; }

/* ── Progress ──────────────────────────────────────────────────────────── */
QProgressBar { background-color: ${surface}; border: none; border-radius: 3px; text-align: center; height: 4px; font-size: 0; }
QProgressBar::chunk { background-color: ${accent}; border-radius: 3px; }

/* ── Scrollbars ────────────────────────────────────────────────────────── */
QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: ${border-light}; border-radius: 5px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: ${scrollbar-hover}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:horizontal { background: ${border-light}; border-radius: 5px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: ${scrollbar-hover}; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Group box ─────────────────────────────────────────────────────────── */
QGroupBox { border: none; margin-top: 14px; padding-top: 18px; font-weight: 600; font-size: 13px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 12px; left: 12px; color: ${text-secondary}; }

/* ── Navigation tabs (top bar) ─────────────────────────────────────────── */
QWidget[nav="true"] { background-color: ${bg}; border-bottom: 1px solid ${border}; }
QTabBar[nav="true"] { border: none; background: transparent; min-height: 44px; }
QTabBar[nav="true"]::tab {
    background: transparent; color: ${text-secondary}; border: none;
    padding: 10px 20px; font-size: 13px; font-weight: 500;
    border-bottom: 2px solid transparent; margin: 0;
}
QTabBar[nav="true"]::tab:selected { color: ${text-primary}; border-bottom: 2px solid ${accent}; }
QTabBar[nav="true"]::tab:hover { color: ${text-primary}; }

/* ── Segmented control (mode switch) ───────────────────────────────────── */
QTabBar[segment="true"] { background-color: ${surface}; border-radius: 10px; padding: 3px; }
QTabBar[segment="true"]::tab {
    background: transparent; color: ${text-secondary}; border: none;
    padding: 7px 20px; border-radius: 8px; margin: 0 1px; font-size: 13px; font-weight: 500;
}
QTabBar[segment="true"]::tab:selected { background-color: ${card}; color: ${text-primary}; }
QTabBar[segment="true"]::tab:hover { color: ${text-primary}; }

/* ── Splitter ──────────────────────────────────────────────────────────── */
QSplitter::handle { background: ${border}; width: 1px; }
