QMainWindow { background-color: #2D2925; color: #F7F3EE; }
QWidget { background-color: transparent; color: #F7F3EE; font-size: 13px; }
QLabel { color: #F7F3EE; font-size: 13px; }
QLabel[class="hint"] { color: #A8A098; font-size: 11px; }
QLabel[class="value"] { color: #BCB5AE; font-size: 11px; }
QLabel[class="section"] { color: #A8A098; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
QLabel[thumbnail="true"] { border-radius: 10px; padding: 2px; background: #4C453E; }
QWidget[card="true"] { background-color: #36312C; border: 1px solid #4C453E; border-radius: 14px; padding: 16px; }
QWidget[card-sub="true"] { background-color: #36312C; border: 1px solid #4C453E; border-radius: 14px; }
QWidget[card-well="true"] { background-color: #4C453E; border: 1px solid #4C453E; border-radius: 10px; padding: 12px; }
QWidget[nav="true"] { background-color: #36312C; border-bottom: 1px solid #4C453E; border-top: none; border-left: none; border-right: none; border-radius: 0; padding: 0; }
QPushButton { background-color: #4C453E; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; padding: 7px 14px; font-size: 13px; font-weight: 500; }
QPushButton:hover { background-color: #5A534C; border-color: #853D4F; }
QPushButton:pressed { background-color: #853D4F; color: #F7F3EE; }
QPushButton:disabled { color: #BCB5AE; border-color: #4C453E; }
QPushButton[flat="true"] { background: transparent; border: none; padding: 6px 4px; }
QPushButton[flat="true"]:hover { color: #853D4F; background: transparent; border: none; }
QPushButton[gradient="true"] { background-color: #853D4F; color: #F7F3EE; border: none; font-weight: 700; border-radius: 14px; padding: 12px 20px; font-size: 16px; }
QPushButton[gradient="true"]:hover { background-color: #AC4962; }
QPushButton[gradient="true"]:pressed { background-color: #5D2D39; }
QPushButton[gradient="true"]:disabled { background-color: #4C453E; color: #BCB5AE; }
QLineEdit { background-color: #1E1C1A; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; padding: 7px 11px; font-size: 13px; selection-background-color: #853D4F; }
QLineEdit:focus { border: 2px solid #853D4F; padding: 6px 10px; }
QLineEdit:disabled { color: #9F9489; }
QTextEdit { background-color: #1E1C1A; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; padding: 8px; font-size: 13px; selection-background-color: #853D4F; }
QTextEdit:focus { border: 2px solid #853D4F; padding: 7px; }
QComboBox { background-color: #1E1C1A; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; padding: 6px 10px; font-size: 13px; min-height: 20px; }
QComboBox:hover { border-color: #853D4F; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; top: 0; bottom: 0; right: 0; width: 24px; border: none; }
QComboBox QAbstractItemView { background-color: #4C453E; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; selection-background-color: #5A534C; selection-color: #853D4F; outline: none; padding: 4px; }
QSpinBox, QDoubleSpinBox { background-color: #1E1C1A; color: #F7F3EE; border: 1px solid #4C453E; border-radius: 10px; padding: 5px 8px; font-size: 13px; min-height: 20px; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #853D4F; padding: 4px 7px; }
QSlider::groove:horizontal { background: #4C453E; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: #853D4F; border: none; width: 16px; height: 16px; border-radius: 8px; margin: -6px 0; }
QSlider::handle:horizontal:hover { background: #BD6A80; }
QSlider::sub-page:horizontal { background: #853D4F; border-radius: 2px; }
QCheckBox { color: #F7F3EE; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 2px solid #4C453E; background: #1E1C1A; }
QCheckBox::indicator:hover { border-color: #853D4F; }
QCheckBox::indicator:checked { background-color: #853D4F; border-color: #853D4F; }
QProgressBar { background-color: #4C453E; border: none; border-radius: 3px; text-align: center; height: 6px; font-size: 0; }
QProgressBar::chunk { background-color: #853D4F; border-radius: 3px; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #6B6157; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #9F9489; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 0; }
QScrollBar::handle:horizontal { background: #6B6157; border-radius: 4px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #9F9489; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QGroupBox { border: 1px solid #4C453E; border-radius: 14px; margin-top: 14px; padding-top: 18px; font-weight: 600; font-size: 13px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 12px; left: 12px; color: #BCB5AE; }
QTabBar[nav="true"] { border: none; background: transparent; padding: 0; min-height: 38px; }
QTabBar[nav="true"]::tab { background: transparent; color: #A8A098; padding: 8px 22px; border: none; font-size: 13px; font-weight: 500; min-width: 60px; border-bottom: 2px solid transparent; margin: 0; }
QTabBar[nav="true"]::tab:selected { color: #E0C3CA; border-bottom: 2px solid #853D4F; }
QTabBar[nav="true"]::tab:hover { color: #BCB5AE; }
QTabBar:!nav { qproperty-drawBase: 0; }
QTabBar:!nav::tab { background: transparent; color: #A8A098; padding: 6px 14px; border: 1px solid #4C453E; font-size: 13px; font-weight: 500; margin-right: -1px; }
QTabBar:!nav::tab:first { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QTabBar:!nav::tab:last { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QTabBar:!nav::tab:selected { background-color: #853D4F; color: #F7F3EE; border-color: #853D4F; }
QTabBar:!nav::tab:hover:!selected { background-color: #5A534C; border-color: #853D4F; }
QSplitter::handle { background: #4C453E; width: 1px; }
