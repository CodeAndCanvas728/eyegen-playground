QMainWindow { background-color: #f0f0f4; color: #1e1e2d; }
QWidget { background-color: transparent; color: #1e1e2d; font-size: 13px; }
QLabel { color: #1e1e2d; font-size: 13px; }
QLabel[class="hint"] { color: #9191a8; font-size: 11px; }
QLabel[class="value"] { color: #5a5a72; font-size: 11px; }
QLabel[class="section"] { color: #9191a8; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
QLabel[thumbnail="true"] { border-radius: 10px; padding: 2px; background: #ffffff; }
QWidget[card="true"] { background-color: #ffffff; border: 1px solid #dcdce6; border-radius: 14px; padding: 16px; }
QWidget[card-sub="true"] { background-color: #ffffff; border: 1px solid #dcdce6; border-radius: 14px; }
QWidget[card-well="true"] { background-color: #ffffff; border: 1px solid #dcdce6; border-radius: 10px; padding: 12px; }
QWidget[nav="true"] { background-color: #ffffff; border-bottom: 1px solid #dcdce6; border-top: none; border-left: none; border-right: none; border-radius: 0; padding: 0; }
QPushButton { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; padding: 7px 14px; font-size: 13px; font-weight: 500; }
QPushButton:hover { background-color: #f5f5fa; border-color: #7c3aed; }
QPushButton:pressed { background-color: #7c3aed; color: white; }
QPushButton:disabled { color: #9191a8; border-color: #dcdce6; }
QPushButton[flat="true"] { background: transparent; border: none; padding: 6px 4px; }
QPushButton[flat="true"]:hover { color: #7c3aed; background: transparent; border: none; }
QPushButton[gradient="true"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7c3aed, stop:1 #c026d3); color: white; border: none; font-weight: 700; border-radius: 14px; padding: 12px 20px; font-size: 15px; }
QPushButton[gradient="true"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8b5cf6, stop:1 #f472b6); }
QPushButton[gradient="true"]:pressed { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #c026d3, stop:1 #ec4899); }
QPushButton[gradient="true"]:disabled { background: #dcdce6; color: #9191a8; }
QLineEdit { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; padding: 7px 11px; font-size: 13px; selection-background-color: #7c3aed; }
QLineEdit:focus { border: 2px solid #7c3aed; padding: 6px 10px; }
QLineEdit:disabled { color: #9191a8; }
QTextEdit { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; padding: 8px; font-size: 13px; selection-background-color: #7c3aed; }
QTextEdit:focus { border: 2px solid #7c3aed; padding: 7px; }
QComboBox { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; padding: 6px 10px; font-size: 13px; min-height: 20px; }
QComboBox:hover { border-color: #7c3aed; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; top: 0; bottom: 0; right: 0; width: 24px; border: none; }
QComboBox QAbstractItemView { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; selection-background-color: #f5f5fa; selection-color: #7c3aed; outline: none; padding: 4px; }
QSpinBox, QDoubleSpinBox { background-color: #ffffff; color: #1e1e2d; border: 1px solid #dcdce6; border-radius: 10px; padding: 5px 8px; font-size: 13px; min-height: 20px; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #7c3aed; padding: 4px 7px; }
QSlider::groove:horizontal { background: #dcdce6; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: #7c3aed; border: none; width: 16px; height: 16px; border-radius: 8px; margin: -6px 0; }
QSlider::handle:horizontal:hover { background: #8b5cf6; }
QSlider::sub-page:horizontal { background: #7c3aed; border-radius: 2px; }
QCheckBox { color: #1e1e2d; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 2px solid #dcdce6; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #7c3aed; }
QCheckBox::indicator:checked { background-color: #7c3aed; border-color: #7c3aed; }
QProgressBar { background-color: #dcdce6; border: none; border-radius: 3px; text-align: center; height: 6px; font-size: 0; }
QProgressBar::chunk { background-color: #7c3aed; border-radius: 3px; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #e6e6ed; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #9191a8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 0; }
QScrollBar::handle:horizontal { background: #e6e6ed; border-radius: 4px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #9191a8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QGroupBox { border: 1px solid #dcdce6; border-radius: 14px; margin-top: 14px; padding-top: 18px; font-weight: 600; font-size: 13px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 12px; left: 12px; color: #5a5a72; }
QTabBar[nav="true"] { border: none; background: transparent; padding: 0; min-height: 38px; }
QTabBar[nav="true"]::tab { background: transparent; color: #9191a8; padding: 8px 22px; border: none; font-size: 13px; font-weight: 500; min-width: 60px; border-bottom: 2px solid transparent; margin: 0; }
QTabBar[nav="true"]::tab:selected { color: #7c3aed; border-bottom: 2px solid #7c3aed; }
QTabBar[nav="true"]::tab:hover { color: #5a5a72; }
QTabBar:!nav { qproperty-drawBase: 0; }
QTabBar:!nav::tab { background: transparent; color: #9191a8; padding: 6px 14px; border: 1px solid #dcdce6; font-size: 13px; font-weight: 500; margin-right: -1px; }
QTabBar:!nav::tab:first { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QTabBar:!nav::tab:last { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QTabBar:!nav::tab:selected { background-color: #7c3aed; color: white; border-color: #7c3aed; }
QTabBar:!nav::tab:hover:!selected { background-color: #f5f5fa; border-color: #7c3aed; }
QSplitter::handle { background: #dcdce6; width: 1px; }
