QMainWindow { background-color: #F8F7F7; color: #361C23; }
QWidget { background-color: transparent; color: #361C23; font-size: 13px; }
QLabel { color: #361C23; font-size: 13px; }
QLabel[class="hint"] { color: #756962; font-size: 11px; }
QLabel[class="value"] { color: #6B6157; font-size: 11px; }
QLabel[class="section"] { color: #756962; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
QLabel[thumbnail="true"] { border-radius: 10px; padding: 2px; background: #FFFFFF; }
QWidget[card="true"] { background-color: #FFFFFF; border: 1px solid #D6D1CD; border-radius: 14px; padding: 16px; }
QWidget[card-sub="true"] { background-color: #FFFFFF; border: 1px solid #D6D1CD; border-radius: 14px; }
QWidget[card-well="true"] { background-color: #FFFFFF; border: 1px solid #D6D1CD; border-radius: 10px; padding: 12px; }
QWidget[nav="true"] { background-color: #FFFFFF; border-bottom: 1px solid #D6D1CD; border-top: none; border-left: none; border-right: none; border-radius: 0; padding: 0; }
QPushButton { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; padding: 7px 14px; font-size: 13px; font-weight: 500; }
QPushButton:hover { background-color: #EAE8E6; border-color: #853D4F; }
QPushButton:pressed { background-color: #853D4F; color: #F7F3EE; }
QPushButton:disabled { color: #756962; border-color: #D6D1CD; }
QPushButton[flat="true"] { background: transparent; border: none; padding: 6px 4px; }
QPushButton[flat="true"]:hover { color: #853D4F; background: transparent; border: none; }
QPushButton[gradient="true"] { background-color: #853D4F; color: #F7F3EE; border: none; font-weight: 700; border-radius: 14px; padding: 12px 20px; font-size: 16px; }
QPushButton[gradient="true"]:hover { background-color: #AC4962; }
QPushButton[gradient="true"]:pressed { background-color: #5D2D39; }
QPushButton[gradient="true"]:disabled { background-color: #D6D1CD; color: #5A524B; }
QLineEdit { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; padding: 7px 11px; font-size: 13px; selection-background-color: #853D4F; }
QLineEdit:focus { border: 2px solid #853D4F; padding: 6px 10px; }
QLineEdit:disabled { color: #756962; }
QTextEdit { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; padding: 8px; font-size: 13px; selection-background-color: #853D4F; }
QTextEdit:focus { border: 2px solid #853D4F; padding: 7px; }
QComboBox { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; padding: 6px 10px; font-size: 13px; min-height: 20px; }
QComboBox:hover { border-color: #853D4F; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; top: 0; bottom: 0; right: 0; width: 24px; border: none; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; selection-background-color: #EFE1E5; selection-color: #853D4F; outline: none; padding: 4px; }
QSpinBox, QDoubleSpinBox { background-color: #FFFFFF; color: #361C23; border: 1px solid #D6D1CD; border-radius: 10px; padding: 5px 8px; font-size: 13px; min-height: 20px; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #853D4F; padding: 4px 7px; }
QSlider::groove:horizontal { background: #D6D1CD; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: #853D4F; border: none; width: 16px; height: 16px; border-radius: 8px; margin: -6px 0; }
QSlider::handle:horizontal:hover { background: #AC4962; }
QSlider::sub-page:horizontal { background: #853D4F; border-radius: 2px; }
QCheckBox { color: #361C23; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 2px solid #D6D1CD; background: #FFFFFF; }
QCheckBox::indicator:hover { border-color: #853D4F; }
QCheckBox::indicator:checked { background-color: #853D4F; border-color: #853D4F; }
QProgressBar { background-color: #D6D1CD; border: none; border-radius: 3px; text-align: center; height: 6px; font-size: 0; }
QProgressBar::chunk { background-color: #853D4F; border-radius: 3px; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #EAE8E6; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #877A6E; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 0; }
QScrollBar::handle:horizontal { background: #EAE8E6; border-radius: 4px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #877A6E; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QGroupBox { border: 1px solid #D6D1CD; border-radius: 14px; margin-top: 14px; padding-top: 18px; font-weight: 600; font-size: 13px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 12px; left: 12px; color: #6B6157; }
QTabBar[nav="true"] { border: none; background: transparent; padding: 0; min-height: 38px; }
QTabBar[nav="true"]::tab { background: transparent; color: #756962; padding: 8px 22px; border: none; font-size: 13px; font-weight: 500; min-width: 60px; border-bottom: 2px solid transparent; margin: 0; }
QTabBar[nav="true"]::tab:selected { color: #853D4F; border-bottom: 2px solid #853D4F; }
QTabBar[nav="true"]::tab:hover { color: #6B6157; }
QTabBar:!nav { qproperty-drawBase: 0; }
QTabBar:!nav::tab { background: transparent; color: #756962; padding: 6px 14px; border: 1px solid #D6D1CD; font-size: 13px; font-weight: 500; margin-right: -1px; }
QTabBar:!nav::tab:first { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QTabBar:!nav::tab:last { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QTabBar:!nav::tab:selected { background-color: #853D4F; color: #F7F3EE; border-color: #853D4F; }
QTabBar:!nav::tab:hover:!selected { background-color: #EAE8E6; border-color: #853D4F; }
QSplitter::handle { background: #D6D1CD; width: 1px; }
